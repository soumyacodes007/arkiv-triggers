# Worker settings. Copy to .env on the server that runs the worker. No real values in this file.

# The worker's own wallet: SECRET, only on this server. Never your main wallet.
WORKER_KEY=

# "own" = only rules assigned to this worker, "any" = also help with public rules
WORKER_MODE=any

# Your main wallet address (the one you connect to the dashboard): public
OPERATOR=
# Signature linking OPERATOR to this worker, copied from the dashboard: public
OPERATOR_SIG=

# Only if this worker sends Telegram messages: SECRET
TG_TOKEN=

# Optional: an Arkiv access key from https://hub.arkiv.network/api-keys for higher rate limits: SECRET
ARKIV_ACCESS_KEY=

# Optional overrides
# ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
# ARKIV_WS_URL=wss://rpc.tiramisu.db-chain.testnet.arkiv.network
